{
  "name": "yire-oil",
  "version": "1.0.0",
  "description": "Yire Oil Service booking site + Square checkout on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply yire-oil --local",
    "db:migrate": "wrangler d1 migrations apply yire-oil --remote",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  },
  "private": true
}